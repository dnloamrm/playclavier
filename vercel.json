{
  "cleanUrls": true,
  "routes": [
    {
      "src": "/_nuxt/(.*)",
      "dest": "/_nuxt/$1"
    },
    {
      "src": "/audio/([a-z]+-v[0-9]+)/(.*)",
      "dest": "/audio/$1/$2",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/midifiles/(.*)",
      "dest": "/midifiles/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Content-Type": "audio/midi",
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/info(?:\\.html)?/?",
      "status": 308,
      "headers": {
        "Location": "/#info"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
